# Supabase 프로젝트 생성 후 대시보드 Project Settings > API에서 값을 채운다.
# 실제 값이 든 .env.local은 커밋하지 않는다 (.gitignore에 이미 포함됨).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (브라우저에 노출됨).
# 관리자 작업(마스터 데이터 시드 등) 외에는 사용하지 않는다 — RLS를 우회하므로 남용 금지.
SUPABASE_SERVICE_ROLE_KEY=
